// ============================================================
// Sistema de Pedidos de Compra - Modelo de dados
// ETAPA 1: Cadastros (usuários, cargos, funções, locais de estoque,
//          fornecedores, produtos e vínculo produto x fornecedor)
// Regras: docs/regras-de-negocio.md
//
// Convenção: nos modelos usamos PascalCase e camelCase (padrão do
// Prisma), e no banco as tabelas e colunas ficam em snake_case,
// em português e sem acento (via @@map e @map).
// ============================================================

generator client {
  provider = "prisma-client"
  // Pasta onde o Prisma gera o cliente (relativa a este arquivo)
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // ATENÇÃO: no Prisma 7 a URL de conexão NÃO fica aqui.
  // Ela é lida do .env pelo arquivo prisma.config.ts.
}

enum TemaUsuario {
  CLARO
  ESCURO
}

// ------------------------------------------------------------
// Usuário do sistema
// O acesso NÃO vem de um cargo ou perfil: cada usuário recebe
// permissões individuais (ver os modelos Permissao e
// PermissaoUsuario), concedidas na tela /permissoes.
// ------------------------------------------------------------
model Usuario {
  id           Int         @id @default(autoincrement())
  nome         String
  email        String      @unique
  senhaHash    String      @map("senha_hash") // NUNCA guardar a senha pura
  imagemChave  String?     @map("imagem_chave")
  tema         TemaUsuario @default(CLARO)
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  movimentos                MovimentoEstoque[]
  logs                      LogSistema[]
  sessoes                   Sessao[]
  permissoes                PermissaoUsuario[]
  cargos                    UsuarioCargo[]
  funcoes                   UsuarioFuncao[]
  transferenciasSolicitadas PedidoTransferencia[] @relation("TransferenciaSolicitante")
  transferenciasEnviadas    PedidoTransferencia[] @relation("TransferenciaRemetente")
  transferenciasRecebidas   PedidoTransferencia[] @relation("TransferenciaRecebedor")
  notificacoes              Notificacao[]
  assinaturasPush           AssinaturaPush[]

  @@map("usuario")
}

// Cargo é informativo e não concede permissões ao usuário.
model Cargo {
  id       Int            @id @default(autoincrement())
  nome     String         @unique
  criadoEm DateTime       @default(now()) @map("criado_em")
  usuarios UsuarioCargo[]

  @@map("cargo")
}

model UsuarioCargo {
  usuarioId Int @map("usuario_id")
  cargoId   Int @map("cargo_id")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cargo   Cargo   @relation(fields: [cargoId], references: [id], onDelete: Restrict)

  @@id([usuarioId, cargoId])
  @@index([cargoId])
  @@map("usuario_cargo")
}

// Função descreve atividades exercidas pelo usuário e não concede acesso.
model Funcao {
  id       Int             @id @default(autoincrement())
  nome     String          @unique
  criadoEm DateTime        @default(now()) @map("criado_em")
  usuarios UsuarioFuncao[]

  @@map("funcao")
}

model UsuarioFuncao {
  usuarioId Int @map("usuario_id")
  funcaoId  Int @map("funcao_id")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  funcao  Funcao  @relation(fields: [funcaoId], references: [id], onDelete: Restrict)

  @@id([usuarioId, funcaoId])
  @@index([funcaoId])
  @@map("usuario_funcao")
}

// ------------------------------------------------------------
// Locais de estoque (seção 3): Loja Nova Iguaçu, Loja Mesquita, Galpão
// Os 3 locais são criados pelo script scripts/seed.ts e podem ser
// gerenciados pelas telas em /locais (criar, renomear e excluir).
// ------------------------------------------------------------
model LocalEstoque {
  id   Int    @id @default(autoincrement())
  nome String @unique

  estoques              Estoque[]
  movimentos            MovimentoEstoque[]
  transferenciasOrigem  PedidoTransferencia[] @relation("TransferenciaOrigem")
  transferenciasDestino PedidoTransferencia[] @relation("TransferenciaDestino")

  @@map("local_estoque")
}

// ------------------------------------------------------------
// Produto (seção 8)
// ------------------------------------------------------------
model Produto {
  id            Int      @id @default(autoincrement())
  nome          String
  unidade       String // Unidade-base do estoque. Ex.: UN ou KG.
  // Mantido como espelho do código da embalagem principal durante a
  // transição; os códigos de barras oficiais ficam em EmbalagemProduto.
  codigoBarras  String?  @map("codigo_barras")
  // Código do produto no ERP (Superus). Opcional, mas único quando
  // preenchido (RN-22). Será a chave da importação futura.
  codigoErp     String?  @unique @map("codigo_erp")
  imagemChave   String?  @map("imagem_chave")
  // Estoque mínimo único por produto, comparado com o TOTAL dos 3
  // locais (RN-05). Aceita decimais (3 casas) para itens vendidos por peso.
  estoqueMinimo Decimal  @default(0) @map("estoque_minimo") @db.Decimal(12, 3)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  fornecedores       ProdutoFornecedor[]
  historicoPrecos    HistoricoPreco[]
  estoques           Estoque[]
  movimentos         MovimentoEstoque[]
  embalagens         EmbalagemProduto[]
  itensTransferencia ItemTransferencia[]

  @@map("produto")
}

model EmbalagemProduto {
  id             Int      @id @default(autoincrement())
  produtoId      Int      @map("produto_id")
  codigoBarras   String   @unique @map("codigo_barras")
  unidade        String
  quantidadeBase Decimal  @map("quantidade_base") @db.Decimal(12, 3)
  principal      Boolean  @default(false)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, principal])
  @@map("embalagem_produto")
}

// ------------------------------------------------------------
// Fornecedor
// ------------------------------------------------------------
model Fornecedor {
  id                Int      @id @default(autoincrement())
  nome              String
  contato           String? // Telefone, e-mail, nome do vendedor etc.
  imagemChave       String?  @map("imagem_chave")
  prazoEntregaDias  Int?     @map("prazo_entrega_dias") // Prazo médio de entrega
  // Valor mínimo de pedido e frete (RN-17). Opcionais.
  valorMinimoPedido Decimal? @map("valor_minimo_pedido") @db.Decimal(12, 2)
  frete             Decimal? @db.Decimal(12, 2)
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now()) @map("criado_em")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  produtos        ProdutoFornecedor[]
  historicoPrecos HistoricoPreco[]

  @@map("fornecedor")
}

// ------------------------------------------------------------
// Vínculo produto x fornecedor (RN-09): relação de muitos para muitos.
// O preço NÃO fica aqui: ele vai para o histórico de preços (etapa 3).
// ------------------------------------------------------------
model ProdutoFornecedor {
  id                 Int     @id @default(autoincrement())
  produtoId          Int     @map("produto_id")
  fornecedorId       Int     @map("fornecedor_id")
  codigoNoFornecedor String? @map("codigo_no_fornecedor")
  ativo              Boolean @default(true)

  produto    Produto    @relation(fields: [produtoId], references: [id])
  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id])

  // Um produto só pode ser vinculado uma vez ao mesmo fornecedor
  @@unique([produtoId, fornecedorId])
  @@index([fornecedorId])
  @@map("produto_fornecedor")
}

// ------------------------------------------------------------
// Histórico de preços (RN-10 e RN-11).
// Módulo 2 grava origem COTADO (digitado pelo comprador, sem pedido).
// Módulo 3 grava origem PAGO ao confirmar o pedido (pedido_id).
// O preço atual de um produto num fornecedor é o registro mais
// recente (por data, depois por id).
// ------------------------------------------------------------
enum OrigemPreco {
  COTADO
  PAGO
}

model HistoricoPreco {
  id            Int         @id @default(autoincrement())
  produtoId     Int         @map("produto_id")
  fornecedorId  Int         @map("fornecedor_id")
  precoUnitario Decimal     @map("preco_unitario") @db.Decimal(12, 2)
  data          DateTime
  origem        OrigemPreco
  // Preenchido no Módulo 3, quando o preço vier de um pedido confirmado
  pedidoId      Int?        @map("pedido_id")

  produto    Produto    @relation(fields: [produtoId], references: [id])
  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id])

  @@index([produtoId, fornecedorId, data])
  @@index([fornecedorId])
  @@map("historico_preco")
}

// ------------------------------------------------------------
// Estoque atual de um produto em um local (RN-01)
// O TOTAL do produto NÃO fica gravado: ele é sempre calculado como
// a soma das linhas de estoque dos locais (ver RN-01).
// A data da última movimentação de cada local fica aqui (RN-03).
// ------------------------------------------------------------
model Estoque {
  id                 Int      @id @default(autoincrement())
  produtoId          Int      @map("produto_id")
  localEstoqueId     Int      @map("local_estoque_id")
  quantidade         Decimal  @default(0) @db.Decimal(12, 3)
  dataUltimaContagem DateTime @default(now()) @map("data_ultima_contagem")
  atualizadoEm       DateTime @updatedAt @map("atualizado_em")

  produto      Produto      @relation(fields: [produtoId], references: [id])
  localEstoque LocalEstoque @relation(fields: [localEstoqueId], references: [id])

  // Existe no máximo uma linha por produto e local
  @@unique([produtoId, localEstoqueId])
  @@index([localEstoqueId])
  @@map("estoque")
}

// ------------------------------------------------------------
// Histórico de movimentações de estoque (RN-02)
// Cada movimentação guarda o produto, o local, o tipo, a
// quantidade, quem fez e quando. O usuário fica vazio até
// existir login no sistema (Item 5).
//   ENTRADA      -> soma ao estoque do local
//   SAIDA        -> subtrai do estoque do local
//   CONTAGEM     -> substitui a quantidade atual do local
//   RECEBIMENTO  -> soma (recebimento de pedido - RN-04)
// ------------------------------------------------------------
enum TipoMovimento {
  ENTRADA
  SAIDA
  CONTAGEM
  RECEBIMENTO
}

model MovimentoEstoque {
  id             Int           @id @default(autoincrement())
  produtoId      Int           @map("produto_id")
  localEstoqueId Int           @map("local_estoque_id")
  usuarioId      Int?          @map("usuario_id")
  tipo           TipoMovimento
  quantidade     Decimal       @db.Decimal(12, 3)
  comentario     String?       @db.VarChar(500)
  dataHora       DateTime      @default(now()) @map("data_hora")

  produto         Produto              @relation(fields: [produtoId], references: [id])
  localEstoque    LocalEstoque         @relation(fields: [localEstoqueId], references: [id])
  usuario         Usuario?             @relation(fields: [usuarioId], references: [id])
  transferenciaId Int?                 @map("transferencia_id")
  transferencia   PedidoTransferencia? @relation(fields: [transferenciaId], references: [id], onDelete: Restrict)

  @@index([produtoId])
  @@index([localEstoqueId])
  @@index([usuarioId])
  @@index([transferenciaId])
  @@map("movimento_estoque")
}

enum StatusTransferencia {
  PENDENTE
  EM_TRANSITO
  CONCLUIDO
}

enum TipoNotificacaoTransferencia {
  SOLICITADO
  ENVIADO
  CONCLUIDO
}

enum StatusEntregaPush {
  PENDENTE
  PROCESSANDO
  ENVIADA
  FALHOU
}

model PedidoTransferencia {
  id            Int                 @id @default(autoincrement())
  origemId      Int                 @map("origem_id")
  destinoId     Int                 @map("destino_id")
  solicitanteId Int                 @map("solicitante_id")
  criadoEm      DateTime            @default(now()) @map("criado_em")
  status        StatusTransferencia @default(PENDENTE)
  enviadoPorId  Int?                @map("enviado_por_id")
  enviadoEm     DateTime?           @map("enviado_em")
  recebidoPorId Int?                @map("recebido_por_id")
  recebidoEm    DateTime?           @map("recebido_em")

  origem       LocalEstoque        @relation("TransferenciaOrigem", fields: [origemId], references: [id], onDelete: Restrict)
  destino      LocalEstoque        @relation("TransferenciaDestino", fields: [destinoId], references: [id], onDelete: Restrict)
  solicitante  Usuario             @relation("TransferenciaSolicitante", fields: [solicitanteId], references: [id], onDelete: Restrict)
  enviadoPor   Usuario?            @relation("TransferenciaRemetente", fields: [enviadoPorId], references: [id], onDelete: Restrict)
  recebidoPor  Usuario?            @relation("TransferenciaRecebedor", fields: [recebidoPorId], references: [id], onDelete: Restrict)
  itens        ItemTransferencia[]
  movimentos   MovimentoEstoque[]
  notificacoes Notificacao[]

  @@index([status, criadoEm])
  @@index([origemId, status])
  @@index([destinoId, status])
  @@index([solicitanteId])
  @@map("pedido_transferencia")
}

model ItemTransferencia {
  id                            Int      @id @default(autoincrement())
  transferenciaId               Int      @map("transferencia_id")
  produtoId                     Int      @map("produto_id")
  quantidadeSolicitada          Decimal  @map("quantidade_solicitada") @db.Decimal(12, 3)
  quantidadeSolicitadaInformada Decimal? @map("quantidade_solicitada_informada") @db.Decimal(12, 3)
  unidadeSolicitada             String?  @map("unidade_solicitada")
  fatorSolicitado               Decimal? @map("fator_solicitado") @db.Decimal(12, 3)
  quantidadeEnviada             Decimal? @map("quantidade_enviada") @db.Decimal(12, 3)
  quantidadeEnviadaInformada    Decimal? @map("quantidade_enviada_informada") @db.Decimal(12, 3)
  unidadeEnviada                String?  @map("unidade_enviada")
  fatorEnviado                  Decimal? @map("fator_enviado") @db.Decimal(12, 3)
  quantidadeRecebida            Decimal? @map("quantidade_recebida") @db.Decimal(12, 3)
  quantidadeRecebidaInformada   Decimal? @map("quantidade_recebida_informada") @db.Decimal(12, 3)
  unidadeRecebida               String?  @map("unidade_recebida")
  fatorRecebido                 Decimal? @map("fator_recebido") @db.Decimal(12, 3)
  justificativaEnvio            String?  @map("justificativa_envio") @db.VarChar(500)
  justificativaDivergencia      String?  @map("justificativa_divergencia") @db.VarChar(500)

  transferencia PedidoTransferencia @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  produto       Produto             @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@unique([transferenciaId, produtoId])
  @@index([produtoId])
  @@map("item_transferencia")
}

model Notificacao {
  id              Int                          @id @default(autoincrement())
  usuarioId       Int                          @map("usuario_id")
  transferenciaId Int                          @map("transferencia_id")
  tipo            TipoNotificacaoTransferencia
  mensagem        String                       @db.VarChar(300)
  criadoEm        DateTime                     @default(now()) @map("criado_em")
  lidaEm          DateTime?                    @map("lida_em")

  usuario       Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  transferencia PedidoTransferencia @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  entregasPush  EntregaPush[]

  @@index([usuarioId, lidaEm, criadoEm])
  @@index([transferenciaId])
  @@map("notificacao")
}

model AssinaturaPush {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @map("usuario_id")
  endpoint     String   @unique @db.VarChar(2048)
  chaveP256dh  String   @map("chave_p256dh") @db.VarChar(255)
  chaveAuth    String   @map("chave_auth") @db.VarChar(255)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuario  Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  entregas EntregaPush[]

  @@index([usuarioId])
  @@map("assinatura_push")
}

model EntregaPush {
  id                 Int               @id @default(autoincrement())
  notificacaoId      Int               @map("notificacao_id")
  assinaturaId       Int               @map("assinatura_id")
  status             StatusEntregaPush @default(PENDENTE)
  tentativas         Int               @default(0)
  proximaTentativaEm DateTime          @default(now()) @map("proxima_tentativa_em")
  bloqueioAte        DateTime?         @map("bloqueio_ate")
  criadoEm           DateTime          @default(now()) @map("criado_em")
  atualizadoEm       DateTime          @updatedAt @map("atualizado_em")
  enviadaEm          DateTime?         @map("enviada_em")
  ultimoErro         String?           @map("ultimo_erro") @db.VarChar(500)

  notificacao Notificacao    @relation(fields: [notificacaoId], references: [id], onDelete: Cascade)
  assinatura  AssinaturaPush @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  @@unique([notificacaoId, assinaturaId])
  @@index([status, proximaTentativaEm])
  @@map("entrega_push")
}

// ------------------------------------------------------------
// Log geral do sistema: histórico de ações de TODOS os módulos
// (produtos, estoque, locais, fornecedores, pedidos, usuários).
// Guarda o módulo, a ação, um texto legível, quem fez e quando.
// O campo "dados" (JSON) fica para detalhes extras, como os
// valores antes e depois de uma alteração.
// ------------------------------------------------------------
enum ModuloSistema {
  PRODUTOS
  ESTOQUE
  LOCAIS
  CARGOS
  FUNCOES
  FORNECEDORES
  PEDIDOS
  USUARIOS
  PERMISSOES
  TRANSFERENCIAS
}

enum AcaoSistema {
  CRIAR
  ALTERAR
  EXCLUIR
  ENTRADA
  SAIDA
  CONTAGEM
  RECEBIMENTO
  SOLICITAR
  ENVIAR
  CONCLUIR
}

model LogSistema {
  id         Int           @id @default(autoincrement())
  modulo     ModuloSistema
  acao       AcaoSistema
  usuarioId  Int?          @map("usuario_id")
  // Id do registro afetado (ex.: id do produto), quando existir
  registroId Int?          @map("registro_id")
  // Texto legível do que aconteceu
  descricao  String
  // Detalhes extras em JSON (ex.: o que mudou)
  dados      Json?
  criadoEm   DateTime      @default(now()) @map("criado_em")

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([modulo])
  @@index([usuarioId])
  @@index([criadoEm])
  @@map("log_sistema")
}

// ------------------------------------------------------------
// Catálogo de permissões (a lista do que PODE ser concedido).
// Separado das concessões: aqui fica apenas a definição de cada
// permissão, gravada a partir do catálogo em código
// (src/lib/permissoes.ts) pelo sincronizador. Um "codigo" único e
// estável identifica a permissão (ex.: "produtos.produto.criar").
// Módulo, funcionalidade e operação são texto livre para que novas
// permissões possam ser registradas sem alterar o banco.
// ------------------------------------------------------------
model Permissao {
  id             Int      @id @default(autoincrement())
  // Identificador único e estável usado no código (nunca muda)
  codigo         String   @unique
  // Agrupamentos que montam a matriz na tela
  modulo         String
  funcionalidade String
  operacao       String
  // Texto legível mostrado ao usuário
  descricao      String
  // Ordem de exibição dentro do módulo/funcionalidade
  ordem          Int      @default(0)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  usuarios PermissaoUsuario[]

  @@index([modulo])
  @@map("permissao")
}

// ------------------------------------------------------------
// Permissões concedidas a cada usuário (a concessão propriamente
// dita). A ausência de linha significa "negado": novas permissões
// nascem negadas até serem concedidas explicitamente.
// @@unique impede conceder a mesma permissão duas vezes ao mesmo
// usuário. Campos de auditoria registram quando foi concedida.
// ------------------------------------------------------------
model PermissaoUsuario {
  id           Int      @id @default(autoincrement())
  usuarioId    Int      @map("usuario_id")
  permissaoId  Int      @map("permissao_id")
  concedidoEm  DateTime @default(now()) @map("concedido_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  // Um usuário só pode ter a mesma permissão uma vez
  @@unique([usuarioId, permissaoId])
  @@index([permissaoId])
  @@map("permissao_usuario")
}

// ------------------------------------------------------------
// Sessões de login. O navegador guarda apenas um token aleatório
// (cookie httpOnly); a sessão de verdade fica no banco, o que
// permite encerrá-la (logout) e expirá-la.
// ------------------------------------------------------------
model Sessao {
  id        String   @id // token aleatório (hex), nunca sequencial
  usuarioId Int      @map("usuario_id")
  criadoEm  DateTime @default(now()) @map("criado_em")
  expiraEm  DateTime @map("expira_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("sessao")
}
